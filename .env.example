# MedX MBBS Bangladesh Platform Environment Configuration
# Copy this file to .env for local deployment

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Supabase Persistent Auth & PostgreSQL (Get from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Gemini API Key (Kept strictly on server; optional - local grounded RAG runs if unconfigured)
GEMINI_API_KEY=

# Curricular Dataset Version
BMDC_CURRICULUM_VERSION=2026.1

# -------------------------------------------------------------
# MedGen 1.3B AI Video Worker Daemon Configuration
# -------------------------------------------------------------
# Secret token shared between backend and separate GPU worker
MEDX_WORKER_TOKEN=your_secure_worker_auth_token_here

# Backend endpoint that worker daemon polls
MEDX_BACKEND_URL=http://localhost:3000

# Hugging Face token for downloading FreedomIntelligence/MedGen-1.3B weights
HF_TOKEN=hf_your_huggingface_read_token_here

# Local directory where MedGen checkpoints are cached
MEDGEN_CHECKPOINT_DIR=./checkpoints/MedGen-1.3B
